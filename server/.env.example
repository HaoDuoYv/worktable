# Worktable Cloud API — 复制为 .env 并填写
NODE_ENV=production
PORT=8788
# 公网部署：0.0.0.0；本机调试可省略（默认 127.0.0.1）
HOST=0.0.0.0
JWT_SECRET=please-change-to-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
DB_PATH=./data/worktable.json
# 网页前端 origin，逗号分隔；桌面端本机回环会自动放行
CORS_ORIGIN=http://localhost:5173,https://worker-table.netlify.app

# 开发模式：不配 SMTP 时验证码打印到控制台
DEV_FAKE_MAIL=false

# 邮箱 SMTP（用户填授权码，勿提交 git）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Worktable <noreply@worktable.local>
